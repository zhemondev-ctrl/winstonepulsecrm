{
  "schema_version": 1,
  "events": {
    "project.call_captured": {
      "event_schema_version": 1,
      "description": "An agent ended a web-dialled call and the CRM saved the call; no number, name or call content.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "lead_linked",
          "connected_claim",
          "duration_bucket"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "web_dialer"
            ]
          },
          "lead_linked": {
            "type": "boolean"
          },
          "connected_claim": {
            "type": "boolean"
          },
          "duration_bucket": {
            "type": "string",
            "enum": [
              "under_10s",
              "10_59s",
              "1_5m",
              "over_5m"
            ]
          }
        }
      }
    },
    "project.call_failed": {
      "event_schema_version": 1,
      "description": "An agent-reported failed call outcome was successfully saved online; not device-verified failure and not merely queued offline.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "string",
            "enum": [
              "agent_report_saved"
            ]
          }
        }
      }
    },
    "project.call_report_save_failed": {
      "event_schema_version": 1,
      "description": "Saving a call report failed; only the failure category is recorded.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "retryable"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "network",
              "server",
              "validation"
            ]
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    },
    "project.call_report_saved": {
      "event_schema_version": 1,
      "description": "A call report was saved to the CRM, or queued on the device while offline.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "reassigned"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "synced",
              "queued_offline"
            ]
          },
          "reassigned": {
            "type": "boolean"
          }
        }
      }
    },
    "project.call_start_failed": {
      "event_schema_version": 1,
      "description": "Existing web call initiation was blocked or its request failed; no raw error or customer identifiers.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "blocked",
              "request_error"
            ]
          }
        }
      }
    },
    "project.call_started": {
      "event_schema_version": 1,
      "description": "Server permitted the call and the web card initiated the phone dial handoff; not evidence of connection.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "lead_linked"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "web_dialer"
            ]
          },
          "lead_linked": {
            "type": "boolean"
          }
        }
      }
    },
    "project.lead_allocation_completed": {
      "event_schema_version": 1,
      "description": "A LeadHub allocation was confirmed and saved; counts of leads assigned/requested and agents receiving leads only.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lead_count",
          "leads_requested",
          "agent_count"
        ],
        "properties": {
          "lead_count": {
            "type": "integer",
            "minimum": 0
          },
          "leads_requested": {
            "type": "integer",
            "minimum": 0
          },
          "agent_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "project.lead_import_completed": {
      "event_schema_version": 1,
      "description": "A lead import (CSV or reviewed file) saved successfully; leads land unassigned. Counts only, no lead IDs or contact details.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "rows_received",
          "rows_accepted",
          "rows_rejected"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "csv",
              "file_review"
            ]
          },
          "rows_received": {
            "type": "integer",
            "minimum": 0
          },
          "rows_accepted": {
            "type": "integer",
            "minimum": 0
          },
          "rows_rejected": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "project.offline_sync_finished": {
      "event_schema_version": 1,
      "description": "A run that re-sends offline calls and reports finished, with counts of items that synced and failed.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "synced",
          "failed"
        ],
        "properties": {
          "synced": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
